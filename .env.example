APP_MODE=competition
APP_VERSION=1.0.0
API_VERSION=v1
DATABASE_URL=sqlite:///./data/agent.db
# Public development hashes for dev-evaluator-key/dev-limited-key. Override in deployment.
EVALUATOR_API_KEY_HASH=496e7a945ef82771e7d92976c76449daa5c6899ffd0c466632846a4e302b65ca
LIMITED_API_KEY_HASH=e15d666e6ed2ac18a4af2bd61bebb3bb779d9c9ad1d369f0c0e18e569323adbe
# Optional deployment account array. When non-empty, it replaces the two legacy keys above.
# Store SHA-256 hashes only; never put plaintext API keys in this file or an image.
API_CLIENTS_JSON=
RATE_LIMIT_TOTAL_PER_MINUTE=60
RATE_LIMIT_AGENT_PER_MINUTE=20
RATE_LIMIT_MCP_PER_MINUTE=100
# JSON arrays. Add the real deployment hostname and browser origin before public deployment.
MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*"]
MCP_ALLOWED_ORIGINS=[]
MCP_SYNC_DEADLINE_SECONDS=25

# DeepSeek answer synthesis. Keep disabled when no provider credential is configured.
LLM_ENABLED=false
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=0
LLM_MAX_OUTPUT_TOKENS=1200
LLM_PROMPT_VERSION=maintenance-agent-v1
LLM_DAILY_BUDGET_CNY=10.00
LLM_BUDGET_TIMEZONE=Asia/Shanghai
LLM_USD_TO_CNY_RATE=7.00
# Conservative peak prices in USD per 1M tokens for deepseek-v4-flash.
DEEPSEEK_INPUT_CACHE_HIT_USD_PER_MILLION=0.014
DEEPSEEK_INPUT_CACHE_MISS_USD_PER_MILLION=0.44
DEEPSEEK_OUTPUT_USD_PER_MILLION=1.32
