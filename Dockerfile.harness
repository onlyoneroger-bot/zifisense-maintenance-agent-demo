FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/app/.venv/bin:$PATH

WORKDIR /app

RUN groupadd --system harness && useradd --system --gid harness --home-dir /app harness

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY fixtures ./fixtures
COPY harness ./harness

RUN pip install --no-cache-dir uv==0.12.6 \
    && uv sync --frozen --no-dev --no-editable \
    && mkdir -p /app/reports \
    && chown -R harness:harness /app

USER harness

ENTRYPOINT ["python", "-m", "harness"]
CMD ["--base-url", "http://maintenance-agent:8080", "--output", "/app/reports"]
